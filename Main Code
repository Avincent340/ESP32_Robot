// ===================== PIN DEFINITIONS =====================
static const int PIN_RMOTOR_1A = 18;
static const int PIN_RMOTOR_2A = 19;
static const int PIN_LMOTOR_3A = 16;
static const int PIN_LMOTOR_4A = 17;

static const int PIN_RPWM_EN  = 26;
static const int PIN_LPWM_EN  = 25;

static const int PIN_LINE_ADC = 32;
static const int PIN_TRIG     = 4;
static const int PIN_ECHO     = 27;

WebServer server(80);
WiFiUDP udp;

// ===================== WIFI =====================
const char* AP_SSID = "ESP32-NOMAD";
const char* AP_PASS = "nomad1234";

// Dual-mode STA network from the provided activity PDF
const char* STA_SSID = "SU-ECE-LAB";
const char* STA_PASS = "FaraDay8086!";
#define UDP_PORT 4210
char incomingPacket[255];
int robotID = 21;

// ===================== MOTOR ORIENTATION =====================
// These values match the common orientation where the right motor must run
// opposite polarity from the left motor for straight forward motion.
static const int RIGHT_FWD_DIR = -1;
static const int LEFT_FWD_DIR  = +1;

// ===================== MODES =====================
enum Mode { MODE_AUTO, MODE_MANUAL, MODE_DANCE };
volatile Mode mode = MODE_MANUAL;

// ===================== SPEEDS =====================
int baseSpeed = 175;
int turnSpeed = 195;
int searchSpeed = 185;
int backSpeed = 165;

// Motor trim for straight motion
int leftTrim  = 0;
int rightTrim = 0;

// ===================== LINE CALIBRATION =====================
int whiteRef = -1;
int blackRef = -1;
int lineThreshold = 2000;
bool lineInvert = false;
int hysteresis = 140;
int thrLow = 1930;
int thrHigh = 2070;
bool lineStateBlack = false;

// ===================== LINE FOLLOW MEMORY =====================
// With a single analog line sensor, the robot cannot directly know left vs right
// when it is completely off the line, so we store the last successful recovery
// direction and search aggressively in that direction first, then alternate.
int lastTurnDir = 0;                   // -1 left, +1 right, 0 unknown
unsigned long lastSeenLineMs = 0;
unsigned long lineLostStartMs = 0;
unsigned long lastRecoveryFlipMs = 0;
int recoveryDir = -1;

// ===================== OBSTACLE =====================
int obstacleStopCm = 18;
int obstacleClearCm = 24;
bool avoiding = false;
unsigned long avoidMs = 0;

// ===================== DANCE =====================
bool danceActive = false;
unsigned long danceStartMs = 0;
int danceStep = 0;

// ===================== HELPERS =====================
static int sampleLineADC(int samples = 80, int delayMs = 3) {
  long sum = 0;
  for (int i = 0; i < samples; i++) {
    sum += analogRead(PIN_LINE_ADC);
    delay(delayMs);
  }
  return (int)(sum / samples);
}

static inline void setMotorRight(int dir, int pwm) {
  if (dir > 0) {
    digitalWrite(PIN_RMOTOR_1A, HIGH);
    digitalWrite(PIN_RMOTOR_2A, LOW);
  } else if (dir < 0) {
    digitalWrite(PIN_RMOTOR_1A, LOW);
    digitalWrite(PIN_RMOTOR_2A, HIGH);
  } else {
    digitalWrite(PIN_RMOTOR_1A, LOW);
    digitalWrite(PIN_RMOTOR_2A, LOW);
  }
  analogWrite(PIN_RPWM_EN, constrain(pwm, 0, 255));
}

static inline void setMotorLeft(int dir, int pwm) {
  if (dir > 0) {
    digitalWrite(PIN_LMOTOR_3A, HIGH);
    digitalWrite(PIN_LMOTOR_4A, LOW);
  } else if (dir < 0) {
    digitalWrite(PIN_LMOTOR_3A, LOW);
    digitalWrite(PIN_LMOTOR_4A, HIGH);
  } else {
    digitalWrite(PIN_LMOTOR_3A, LOW);
    digitalWrite(PIN_LMOTOR_4A, LOW);
  }
  analogWrite(PIN_LPWM_EN, constrain(pwm, 0, 255));
}

static inline int applyLeftTrim(int pwm) {
  return constrain(pwm + leftTrim, 0, 255);
}

static inline int applyRightTrim(int pwm) {
  return constrain(pwm + rightTrim, 0, 255);
}

static inline void driveRaw(int rightDir, int rightPwm, int leftDir, int leftPwm) {
  setMotorRight(rightDir, applyRightTrim(rightPwm));
  setMotorLeft(leftDir, applyLeftTrim(leftPwm));
}

static inline void driveStop() {
  driveRaw(0, 0, 0, 0);
}

static inline void driveForward(int spd) {
  driveRaw(RIGHT_FWD_DIR, spd, LEFT_FWD_DIR, spd);
}

static inline void driveBackward(int spd) {
  driveRaw(-RIGHT_FWD_DIR, spd, -LEFT_FWD_DIR, spd);
}

static inline void driveForwardBiasLeft(int fastPwm, int slowPwm) {
  // biases robot left while still moving forward
  driveRaw(RIGHT_FWD_DIR, fastPwm, LEFT_FWD_DIR, slowPwm);
  lastTurnDir = -1;
}

static inline void driveForwardBiasRight(int fastPwm, int slowPwm) {
  // biases robot right while still moving forward
  driveRaw(RIGHT_FWD_DIR, slowPwm, LEFT_FWD_DIR, fastPwm);
  lastTurnDir = +1;
}

static inline void turnLeft(int spd) {
  // pivot left in place
  driveRaw(-RIGHT_FWD_DIR, spd, LEFT_FWD_DIR, spd);
  lastTurnDir = -1;
}

static inline void turnRight(int spd) {
  // pivot right in place
  driveRaw(RIGHT_FWD_DIR, spd, -LEFT_FWD_DIR, spd);
  lastTurnDir = +1;
}

static inline int readLineRaw() {
  return analogRead(PIN_LINE_ADC);
}

static void updateThresholds() {
  thrLow = constrain(lineThreshold - hysteresis / 2, 0, 4095);
  thrHigh = constrain(lineThreshold + hysteresis / 2, 0, 4095);
}

static bool isBlackHysteresis(int raw) {
  bool black;

  if (!lineInvert) {
    if (!lineStateBlack) black = (raw <= thrLow);
    else black = !(raw >= thrHigh);
  } else {
    if (!lineStateBlack) black = (raw >= thrHigh);
    else black = !(raw <= thrLow);
  }

  lineStateBlack = black;
  return black;
}

static float readDistanceCm() {
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(PIN_TRIG, LOW);

  unsigned long dur = pulseIn(PIN_ECHO, HIGH, 25000UL);
  if (dur == 0) return 999.0f;
  return (float)dur / 58.2f;
}

static bool calibratedOK() {
  return (whiteRef >= 0 && blackRef >= 0 && whiteRef != blackRef);
}

static void resetTrackingState() {
  lineStateBlack = false;
  lastTurnDir = 0;
  lastSeenLineMs = millis();
  lineLostStartMs = 0;
  lastRecoveryFlipMs = 0;
  recoveryDir = -1;
}

// ===================== DANCE =====================
static void startDance() {
  danceActive = true;
  danceStartMs = millis();
  danceStep = 0;
  mode = MODE_DANCE;
}

static void runDance() {
  if (!danceActive) return;

  const unsigned long danceDurationMs = 30000;   // 30 seconds total
  const unsigned long patternMs = 1700;          // one dance loop length
  unsigned long t = millis() - danceStartMs;

  if (t >= danceDurationMs) {
    driveStop();
    danceActive = false;
    mode = MODE_MANUAL;
    return;
  }

  unsigned long phase = t % patternMs;

  if (phase < 220) {
    driveForward(190);
  } else if (phase < 440) {
    driveBackward(190);
  } else if (phase < 740) {
    turnLeft(190);
  } else if (phase < 1040) {
    turnRight(190);
  } else if (phase < 1260) {
    driveForwardBiasLeft(210, 95);
  } else if (phase < 1480) {
    driveForwardBiasRight(210, 95);
  } else {
    driveBackward(170);
  }
}

// ===================== UDP DANCE COMMANDS =====================
static void handleUdpCommand(const String& cmd) {
  if (cmd == "DANCE_ALL") {
    startDance();
    return;
  }

  if (cmd.startsWith("DANCE_")) {
    int target = cmd.substring(6).toInt();
    if (target == robotID) startDance();
  }
}

static void pollUdp() {
  int packetSize = udp.parsePacket();
  if (!packetSize) return;

  int len = udp.read(incomingPacket, sizeof(incomingPacket) - 1);
  if (len < 0) return;
  incomingPacket[len] = 0;

  String cmd = String(incomingPacket);
  cmd.trim();
  handleUdpCommand(cmd);
}

// ===================== AUTO =====================
static void autoObstacleAvoid() {
  float d = readDistanceCm();

  if (!avoiding) {
    if (d <= obstacleStopCm) {
      avoiding = true;
      avoidMs = millis();
      driveStop();
    }
    return;
  }

  unsigned long t = millis() - avoidMs;

  if (t < 120) {
    driveStop();
    return;
  }

  if (t < 420) {
    driveBackward(backSpeed);
    return;
  }

  if (d >= obstacleClearCm) {
    avoiding = false;
    driveStop();
    delay(40);
    return;
  }

  if (((t / 700UL) % 2UL) == 0UL) turnLeft(turnSpeed);
  else turnRight(turnSpeed);
}

static void autoLineFollowAndRecover() {
  int raw = readLineRaw();
  bool onBlack = isBlackHysteresis(raw);
  unsigned long now = millis();

  if (onBlack) {
    lastSeenLineMs = now;
    lineLostStartMs = 0;

    // More aggressive analog steering for tighter curves.
    int error = raw - lineThreshold;
    int mag = abs(error);
    int delta = map(constrain(mag, 0, 1500), 0, 1500, 20, 135);
    int fast = constrain(baseSpeed + delta, 0, 255);
    int slow = constrain(baseSpeed - delta - 15, 0, 255);

    if (!lineInvert) {
      // darker = smaller ADC value
      if (error < -35) {
        driveForwardBiasLeft(fast, slow);
      } else if (error > 35) {
        driveForwardBiasRight(fast, slow);
      } else {
        driveForward(baseSpeed);
      }
    } else {
      if (error > 35) {
        driveForwardBiasLeft(fast, slow);
      } else if (error < -35) {
        driveForwardBiasRight(fast, slow);
      } else {
        driveForward(baseSpeed);
      }
    }
    return;
  }

  if (lineLostStartMs == 0) {
    lineLostStartMs = now;
    recoveryDir = (lastTurnDir == 0) ? -1 : lastTurnDir;
    lastRecoveryFlipMs = now;
  }

  unsigned long lostFor = now - lineLostStartMs;

  // Brief reverse first so the sensor can see the line again instead of driving deeper away.
  if (lostFor < 90) {
    driveBackward(backSpeed);
    return;
  }

  // Then do a directional sweep. Start with last known direction, then alternate.
  if (now - lastRecoveryFlipMs > 280) {
    recoveryDir = -recoveryDir;
    lastRecoveryFlipMs = now;
  }

  int sweep = searchSpeed;
  if (lostFor > 900) sweep = constrain(searchSpeed + 20, 0, 255);
  if (lostFor > 1800) sweep = constrain(searchSpeed + 35, 0, 255);

  if (recoveryDir < 0) turnLeft(sweep);
  else turnRight(sweep);
}

static void runAuto() {
  if (!calibratedOK()) {
    driveStop();
    return;
  }

  autoObstacleAvoid();
  if (avoiding) return;

  autoLineFollowAndRecover();
}

