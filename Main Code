static inline int signedToDir(int v) {
  if (v > 0) return +1;
  if (v < 0) return -1;
  return 0;
}

static void driveTank(int leftCmd, int rightCmd) {
  leftCmd = constrain(leftCmd, -255, 255);
  rightCmd = constrain(rightCmd, -255, 255);

  int leftDir = signedToDir(leftCmd) * LEFT_FWD_DIR;
  int rightDir = signedToDir(rightCmd) * RIGHT_FWD_DIR;

  setMotorLeft(leftDir, abs(leftCmd));
  setMotorRight(rightDir, abs(rightCmd));
}

static void handleJoyDrive(int x, int y) {
  // x: left/right  (-100..100)
  // y: forward/back (-100..100), positive means forward from the web UI
  x = constrain(x, -100, 100);
  y = constrain(y, -100, 100);

  // Arcade drive mix
  int leftMix = y + x;
  int rightMix = y - x;

  leftMix = constrain(leftMix, -100, 100);
  rightMix = constrain(rightMix, -100, 100);

  int maxForward = baseSpeed;
  int maxBackward = backSpeed;

  int leftCmd = (leftMix >= 0) ? map(leftMix, 0, 100, 0, maxForward)
                               : -map(-leftMix, 0, 100, 0, maxBackward);
  int rightCmd = (rightMix >= 0) ? map(rightMix, 0, 100, 0, maxForward)
                                 : -map(-rightMix, 0, 100, 0, maxBackward);

  driveTank(leftCmd, rightCmd);
}

// ===================== ROUTES =====================
static void handleRoot() {
  server.send(200, "text/html", htmlPage());
}

static void handleMode() {
  if (server.hasArg("set")) {
    String m = server.arg("set");
    if (m == "auto") {
      mode = MODE_AUTO;
      danceActive = false;
    }
    if (m == "manual") {
      mode = MODE_MANUAL;
      danceActive = false;
      driveStop();
    }
  }
  server.send(200, "text/plain", "OK");
}

static void handleDrive() {
  if (mode == MODE_AUTO || mode == MODE_DANCE) {
    server.send(403, "text/plain", "Switch to MANUAL first.");
    return;
  }

  String cmd = server.arg("cmd");

  if (cmd == "fwd") driveForward(baseSpeed);
  else if (cmd == "back") driveBackward(backSpeed);
  else if (cmd == "left") turnLeft(turnSpeed);
  else if (cmd == "right") turnRight(turnSpeed);
  else driveStop();

  server.send(200, "text/plain", "OK");
}

static void handleJoy() {
  if (mode == MODE_AUTO || mode == MODE_DANCE) {
    server.send(403, "text/plain", "Switch to MANUAL first.");
    return;
  }

  int x = server.hasArg("x") ? server.arg("x").toInt() : 0;
  int y = server.hasArg("y") ? server.arg("y").toInt() : 0;
  handleJoyDrive(x, y);
  server.send(200, "text/plain", "OK");
}

static void handleSet() {
  if (server.hasArg("base"))  baseSpeed = constrain(server.arg("base").toInt(), 0, 255);
  if (server.hasArg("turn")) {
    turnSpeed = constrain(server.arg("turn").toInt(), 0, 255);
    searchSpeed = turnSpeed;
  }
  if (server.hasArg("back"))  backSpeed = constrain(server.arg("back").toInt(), 0, 255);
  if (server.hasArg("line"))  lineThreshold = constrain(server.arg("line").toInt(), 0, 4095);
  if (server.hasArg("obs"))   obstacleStopCm = constrain(server.arg("obs").toInt(), 5, 150);
  if (server.hasArg("hys"))   hysteresis = constrain(server.arg("hys").toInt(), 20, 2000);
  if (server.hasArg("ltrim")) leftTrim = constrain(server.arg("ltrim").toInt(), -80, 80);
  if (server.hasArg("rtrim")) rightTrim = constrain(server.arg("rtrim").toInt(), -80, 80);

  if (server.hasArg("invert") && server.arg("invert") == "toggle") lineInvert = !lineInvert;

  updateThresholds();
  server.send(200, "text/plain", "OK");
}

static void handleCal() {
  if (!server.hasArg("step")) {
    server.send(400, "text/plain", "Missing step");
    return;
  }

  String step = server.arg("step");
  driveStop();
  delay(120);

  int v = sampleLineADC(100, 3);

  if (step == "white") whiteRef = v;
  else if (step == "black") blackRef = v;
  else {
    server.send(400, "text/plain", "Invalid step");
    return;
  }

  if (whiteRef >= 0 && blackRef >= 0) {
    lineInvert = (blackRef > whiteRef);
    lineThreshold = (whiteRef + blackRef) / 2;
    updateThresholds();
    resetTrackingState();
  }

  server.send(200, "text/plain",
              String("OK ") + step + "=" + v +
              " white=" + whiteRef +
              " black=" + blackRef +
              " thr=" + lineThreshold +
              " invert=" + (lineInvert ? "1" : "0") +
              " low=" + thrLow +
              " high=" + thrHigh);
}

static void handleDance() {
  startDance();
  server.send(200, "text/plain", "DANCING");
}

// ===================== SETUP / LOOP =====================
void setup() {
  Serial.begin(115200);

  pinMode(PIN_RMOTOR_1A, OUTPUT);
  pinMode(PIN_RMOTOR_2A, OUTPUT);
  pinMode(PIN_LMOTOR_3A, OUTPUT);
  pinMode(PIN_LMOTOR_4A, OUTPUT);
  pinMode(PIN_RPWM_EN, OUTPUT);
  pinMode(PIN_LPWM_EN, OUTPUT);

  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);

  driveStop();
  analogReadResolution(12);
  updateThresholds();
  resetTrackingState();

  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);

  WiFi.begin(STA_SSID, STA_PASS);
  Serial.print("Connecting to STA WiFi");
  unsigned long staStart = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - staStart < 15000UL) {
    delay(500);
    Serial.print('.');
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("STA connected. IP: ");
    Serial.println(WiFi.localIP());
    udp.begin(UDP_PORT);
    Serial.print("UDP listening on ");
    Serial.println(UDP_PORT);
  } else {
    Serial.println("STA connect timeout. AP mode still available.");
    udp.begin(UDP_PORT);
  }

  server.on("/", handleRoot);
  server.on("/mode", handleMode);
  server.on("/drive", handleDrive);
  server.on("/joy", handleJoy);
  server.on("/set", handleSet);
  server.on("/cal", handleCal);
  server.on("/dance", handleDance);

  server.begin();
}

void loop() {
  server.handleClient();
  pollUdp();

  if (danceActive || mode == MODE_DANCE) {
    runDance();
    return;
  }

  if (mode == MODE_AUTO) {
    runAuto();
  }
}
